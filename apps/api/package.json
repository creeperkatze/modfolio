{
	"name": "modfolio-api",
	"private": true,
	"scripts": {
		"build": "cargo build --release --locked",
		"dev": "cargo run",
		"start": "cargo run --release --locked",
		"test": "cargo test --locked",
		"test:coverage": "cargo llvm-cov --locked --lcov --output-path coverage/lcov.info",
		"lint": "cargo fmt --check && cargo clippy --all-targets --locked -- -D warnings",
		"lint:fix": "cargo fmt && cargo clippy --all-targets --fix --allow-dirty -- -D warnings"
	}
}
