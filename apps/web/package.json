{
	"name": "modfolio-web",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vue-tsc --noEmit && vite build",
		"preview": "vite preview",
		"typecheck": "vue-tsc --noEmit",
		"intl:extract": "formatjs extract \"src/**/*.{vue,ts}\" --ignore \"src/**/*.d.ts\" --out-file src/locales/en-US/index.json --format crowdin --preserve-whitespace",
		"intl:prune": "node scripts/prune-locales.js"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@lucide/vue": "^1.66.0",
		"vue": "^3.5.44",
		"vue-i18n": "^11.4.17"
	},
	"devDependencies": {
		"@formatjs/cli": "^6.18.0",
		"@tailwindcss/vite": "^4.3.3",
		"@vitejs/plugin-vue": "^6.0.10",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"vite-svg-loader": "^5.1.3",
		"vue-tsc": "3.3.14"
	}
}
